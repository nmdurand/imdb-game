# Copy this file to .env.local.

# --- DB ---
# Local Docker Postgres (default — start the container with `docker compose up -d`)
DATABASE_URL=postgres://imdbgame:imdbgame@localhost:5433/imdbgame

# Neon (or any remote Postgres). Use the *pooled* host (-pooler) in prod.
# DATABASE_URL=postgres://user:password@your-host.neon.tech/db?sslmode=require

# --- TMDB (seed only) ---
# Get a free API key at https://www.themoviedb.org/settings/api
# Used by `yarn db:seed` to fetch top movies + plot + cast + crew.
TMDB_API_KEY=

# How many top-rated movies to import (TMDB paginates 20 per page).
# Default 200 is plenty for a small game; raise to 1000 if you want the full top list.
SEED_MOVIE_COUNT=200
